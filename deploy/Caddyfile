# Anything else served from this box drops a file in here. This line exists
# because setup-vps.sh overwrites this Caddyfile every time it runs, so a
# second service configured by hand would be silently dropped on the next
# update-server re-run.
import /etc/caddy/conf.d/*.caddy

# Update server for WoWs Tactics Suite.
#
# Serves the release folder over HTTPS (certificate handled by Caddy) to
# requests carrying the update token, and nothing to anyone else. Both values
# come from /etc/caddy/wows-updates.env, which deploy/setup-vps.sh writes.

#
# Usage stats: the access log keeps no IP address and no header (the token
# included), only time, method, path, status, size and the version the app
# says it is (X-Suite-Version, logged as app_version). fw-suite.de's fw-stats
# counts update checks and update downloads from it; see that repo's
# deploy/stats/.

{$UPDATE_DOMAIN} {
	log {
		output file /var/log/caddy/wows-updates-access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				resp_headers delete
				user_id delete
			}
		}
	}
	log_append app_version {http.request.header.X-Suite-Version}

	@authorized header Authorization "Bearer {$UPDATE_TOKEN}"

	handle @authorized {
		root * /srv/wows-updates
		# Manifests must never be served stale; the installers are versioned.
		@manifests path /latest.yml /portable.json /patch-notes.json
		header @manifests Cache-Control "no-store"
		file_server
	}

	handle {
		respond 401
	}
}
