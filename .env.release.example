# Copy to .env.release (untracked) and fill in. Read by the build (UPDATE_*)
# and by `npm run release` (VPS_*).

# Where installed apps look for updates, and the token they present. The token
# is baked into every build; it only unlocks the update folder on the VPS.
# deploy/setup-vps.sh prints both.
UPDATE_URL=https://updates.example.com
UPDATE_TOKEN=

# The clan bot, for Connect Discord and Share to Discord. No path, no trailing
# slash. Not a secret: people sign in with their own Discord account. Leave it
# empty and the build has no Discord features.
BOT_URL=https://bot.example.com

# SSH login and folder that `npm run release` uploads releases to.
VPS_SSH=you@203.0.113.10
VPS_DIR=/srv/wows-updates

# Folder the download site is uploaded to (deploy/setup-site.sh creates it).
# Leave it empty and `npm run release` skips the site.
VPS_SITE_DIR=/srv/wows-site
